{
  "name": "jq",
  "description": "Compact jq output \u2014 truncate large JSON results",
  "match_command": "^jq\\b",
  "strip_ansi": true,
  "strip_lines_matching": [
    "^\\s*$"
  ],
  "keep_lines_matching": [],
  "match_output": [],
  "max_lines": 40,
  "tail_lines": null,
  "truncate_lines_at": 120,
  "on_empty": null,
  "source": "rtk-ai/rtk (src/filters/jq.toml)",
  "license": "Apache-2.0",
  "modified": true,
  "tests": [
    {
      "name": "short output passes through",
      "input": "{\n  \"name\": \"test\",\n  \"version\": \"1.0\"\n}\n",
      "expected": "{\n  \"name\": \"test\",\n  \"version\": \"1.0\"\n}"
    },
    {
      "name": "empty input passes through",
      "input": "",
      "expected": ""
    }
  ]
}