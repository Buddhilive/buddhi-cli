{
  "name": "just",
  "description": "Compact just task runner output \u2014 strip recipe headers, keep command output",
  "match_command": "^just\\b",
  "strip_ansi": true,
  "strip_lines_matching": [
    "^\\s*$",
    "^\\s*Available recipes:",
    "^\\s*just --list"
  ],
  "keep_lines_matching": [],
  "match_output": [],
  "max_lines": 50,
  "tail_lines": null,
  "truncate_lines_at": 150,
  "on_empty": null,
  "source": "rtk-ai/rtk (src/filters/just.toml)",
  "license": "Apache-2.0",
  "modified": true,
  "tests": [
    {
      "name": "preserves command output",
      "input": "cargo test\n\ntest result: ok. 42 passed; 0 failed\n",
      "expected": "cargo test\ntest result: ok. 42 passed; 0 failed"
    },
    {
      "name": "preserves error output",
      "input": "error: Compilation failed\nsrc/main.rs:10: expected `;`",
      "expected": "error: Compilation failed\nsrc/main.rs:10: expected `;`"
    },
    {
      "name": "empty input",
      "input": "",
      "expected": ""
    }
  ]
}