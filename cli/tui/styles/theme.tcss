/* ============================================================
   Buddhi TUI — Design System
   Primary: #da6243 (terracotta)
   ============================================================ */

/* ----- Color Variables (Textual 0.75+ supports $vars) ----- */
$bg:            #131010;
$surface:       #1e1512;
$surface-raised:#271a16;
$border:        #3d2820;
$primary:       #da6243;
$primary-hover: #e8745a;
$primary-muted: #6b2e1f;
$secondary:     #d4935a;
$accent:        #f0c4a0;
$user-bubble:   #221512;
$text:          #f0e4dc;
$text-muted:    #a07060;
$success:       #7ab897;
$error:         #cf5858;

/* ----- App Root ----- */
Screen {
    background: $bg;
    color: $text;
}

/* ----- Sidebar ----- */
#sidebar {
    width: 28;
    height: 100%;
    background: $surface;
    border-right: tall $border;
    padding: 0;
}

#sidebar-title {
    background: $surface-raised;
    color: $primary;
    text-style: bold;
    padding: 1 2;
    border-bottom: tall $border;
}

#new-chat-btn {
    background: $primary-muted;
    color: $accent;
    border: none;
    margin: 1 1 0 1;
    padding: 0 1;
    text-style: bold;
}

#new-chat-btn:hover {
    background: $primary;
    color: $bg;
}

#new-chat-btn:focus {
    background: $primary;
    color: $bg;
    border: none;
}

#conv-list {
    background: $surface;
    border: none;
    margin: 0;
    padding: 0;
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: $primary-muted;
    scrollbar-color-hover: $primary;
}

#conv-list > ListItem {
    background: $surface;
    color: $text-muted;
    padding: 0 2;
    border-bottom: tall $border;
}

#conv-list > ListItem:hover {
    background: $surface-raised;
    color: $accent;
}

#conv-list > ListItem.--highlight {
    background: $primary-muted;
    color: $accent;
    border-left: tall $primary;
}

/* ----- Main Content Area ----- */
#main-area {
    width: 1fr;
    height: 100%;
    background: $bg;
}

/* ----- Chat Screen ----- */
#chat-screen {
    width: 100%;
    height: 100%;
    layout: vertical;
}

/* ----- Message List ----- */
#message-list {
    height: 1fr;
    background: $bg;
    padding: 1 2;
    scrollbar-size: 1 1;
    scrollbar-color: $primary-muted;
    scrollbar-color-hover: $primary;
    overflow-y: auto;
}

/* ----- Chat Message Bubbles ----- */
.message-user {
    background: $user-bubble;
    border-left: tall $primary;
    margin: 1 0 0 6;
    padding: 1 2;
    color: $text;
}

.message-assistant {
    background: $surface;
    border-left: tall $border;
    margin: 1 6 0 0;
    padding: 1 2;
    color: $text;
}

.message-role {
    color: $primary;
    text-style: bold;
    margin-bottom: 0;
}

.message-role-assistant {
    color: $secondary;
    text-style: bold;
    margin-bottom: 0;
}

.message-time {
    color: $text-muted;
    text-style: italic;
    margin-left: 1;
}

/* Markdown within assistant bubbles */
.message-assistant Markdown {
    background: $surface;
    color: $text;
    margin: 0;
    padding: 0;
}

.message-assistant MarkdownFence {
    background: $surface-raised;
    border: tall $border;
    margin: 1 0;
    padding: 0 1;
    color: $secondary;
}

/* ----- Input Bar ----- */
#input-bar {
    height: auto;
    min-height: 3;
    max-height: 8;
    background: $surface;
    border-top: tall $border;
    padding: 0 1;
    layout: horizontal;
}

#chat-input {
    height: auto;
    width: 1fr;
    background: $surface;
    color: $text;
    border: none;
    padding: 1 1;
}

#chat-input:focus {
    border: none;
    background: $surface-raised;
}

#send-btn {
    width: 9;
    height: 3;
    background: $primary-muted;
    color: $accent;
    border: none;
    margin: 0 0 0 1;
    text-style: bold;
}

#send-btn:hover {
    background: $primary;
    color: $bg;
}

#send-btn:focus {
    background: $primary;
    color: $bg;
    border: none;
}

#send-btn.streaming {
    background: $surface-raised;
    color: $text-muted;
}

/* ----- Status Bar ----- */
#status-bar {
    height: 1;
    background: $surface-raised;
    color: $text-muted;
    padding: 0 2;
    layout: horizontal;
    dock: bottom;
}

#status-model {
    color: $secondary;
    text-style: bold;
}

#status-server {
    color: $success;
}

#status-server.offline {
    color: $error;
}

/* ----- Welcome Screen ----- */
#welcome-screen {
    align: center middle;
    background: $bg;
}

#welcome-logo {
    color: $primary;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#welcome-subtitle {
    color: $text-muted;
    text-align: center;
    margin-bottom: 2;
}

#welcome-shortcuts {
    background: $surface;
    border: tall $border;
    padding: 1 3;
    width: auto;
    min-width: 40;
}

#welcome-shortcuts .shortcut-key {
    color: $primary;
    text-style: bold;
}

#welcome-shortcuts .shortcut-desc {
    color: $text-muted;
}

/* ----- Loading Indicator ----- */
LoadingIndicator {
    color: $primary;
    background: $bg;
}

/* ----- Help Overlay ----- */
#help-overlay {
    align: center middle;
    background: $bg 90%;
}

#help-panel {
    background: $surface;
    border: tall $primary;
    padding: 2 4;
    width: 50;
    height: auto;
}

#help-title {
    color: $primary;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    border-bottom: tall $border;
    padding-bottom: 1;
}

/* ----- Error Widget ----- */
#error-panel {
    background: $surface;
    border: tall $error;
    padding: 1 2;
    margin: 2;
    color: $error;
}

/* ----- Scrollbar global override ----- */
ScrollBar {
    background: $surface;
}

ScrollBar > .scrollbar--bar {
    color: $primary-muted;
}

ScrollBar > .scrollbar--bar:hover {
    color: $primary;
}
